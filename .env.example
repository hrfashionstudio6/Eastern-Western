DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_database_name
DB_USER=your_hostinger_database_user
DB_PASSWORD=your_database_password
# DATABASE_URL=mysql://user:password@localhost:3306/database (alternative)
# Optional, verified TLS for a remote database:
# DB_SSL=true
# One-time import on first startup. Keep the source URI private and unchanged.
MIGRATE_FROM_MONGODB=false
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# MONGODB_DB=easternwestern
ADMIN_PASSWORD=use-a-strong-local-password
ADMIN_TOKEN=use-a-long-random-token
PORT=5050
HOST=127.0.0.1
CUSTOMER_TOKEN_SECRET=use-a-long-random-token
